rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberDocPath(householdId, uid) {
      return /databases/$(database)/documents/householdMembers/$(householdId + '_' + uid);
    }

    function isHouseholdMember(householdId) {
      return signedIn() && exists(memberDocPath(householdId, request.auth.uid));
    }

    function isHouseholdOwner(householdId) {
      return isHouseholdMember(householdId) && get(memberDocPath(householdId, request.auth.uid)).data.role == 'owner';
    }

    function validPricingPlan(value) {
      return value in ['free', 'monthly', 'yearly'];
    }

    function hasValidProfileShape(data) {
      return data.keys().hasOnly([
        'id',
        'email',
        'display_name',
        'pricing_plan',
        'is_beta_tester',
        'created_at',
        'updated_at'
      ]) &&
        data.id == request.auth.uid &&
        (!('email' in data) || data.email == null || data.email is string) &&
        (!('display_name' in data) || data.display_name == null || data.display_name is string) &&
        (!('created_at' in data) || data.created_at is string) &&
        (!('updated_at' in data) || data.updated_at is string) &&
        (!('pricing_plan' in data) || (data.pricing_plan is string && validPricingPlan(data.pricing_plan))) &&
        (!('is_beta_tester' in data) || data.is_beta_tester is bool);
    }

    function clientCanCreateProfile(data) {
      return (!('pricing_plan' in data) || data.pricing_plan == 'free') &&
        (!('is_beta_tester' in data) || data.is_beta_tester == false);
    }

    function clientCanUpdateBetaFlag(newData, oldData) {
      return (
        (
          'is_beta_tester' in oldData &&
          'is_beta_tester' in newData &&
          newData.is_beta_tester == oldData.is_beta_tester
        ) ||
        (
          !('is_beta_tester' in oldData) &&
          (!('is_beta_tester' in newData) || newData.is_beta_tester == false)
        )
      );
    }

    function clientCanUpdatePricingPlan(newData, oldData) {
      return (
        !('pricing_plan' in newData) ||
        (
          !('pricing_plan' in oldData) &&
          newData.pricing_plan == 'free'
        ) ||
        (
          'pricing_plan' in oldData &&
          (
            newData.pricing_plan == oldData.pricing_plan ||
            newData.pricing_plan == 'free'
          )
        )
      );
    }

    match /profiles/{userId} {
      allow read: if signedIn() && userId == request.auth.uid;
      allow create: if signedIn() &&
        userId == request.auth.uid &&
        hasValidProfileShape(request.resource.data) &&
        clientCanCreateProfile(request.resource.data);
      allow update: if signedIn() &&
        userId == request.auth.uid &&
        hasValidProfileShape(request.resource.data) &&
        request.resource.data.id == resource.data.id &&
        clientCanUpdateBetaFlag(request.resource.data, resource.data) &&
        clientCanUpdatePricingPlan(request.resource.data, resource.data);
    }

    match /households/{householdId} {
      allow read: if isHouseholdMember(householdId);
      allow create: if signedIn() && request.resource.data.created_by == request.auth.uid;
      allow update, delete: if isHouseholdOwner(householdId);
    }

    match /householdMembers/{memberId} {
      allow read: if signedIn() && (
        resource.data.user_id == request.auth.uid ||
        isHouseholdMember(resource.data.household_id)
      );

      allow create: if signedIn() && (
        request.resource.data.user_id == request.auth.uid ||
        isHouseholdOwner(request.resource.data.household_id)
      );

      allow update, delete: if signedIn() && (
        resource.data.user_id == request.auth.uid ||
        isHouseholdOwner(resource.data.household_id)
      );
    }

    match /householdInvites/{token} {
      allow read: if signedIn() && isHouseholdMember(resource.data.household_id);
      allow create: if signedIn() && isHouseholdOwner(request.resource.data.household_id);
      allow update, delete: if signedIn() && isHouseholdOwner(resource.data.household_id);
    }

    match /readingSessions/{sessionId} {
      allow read: if signedIn() && isHouseholdMember(resource.data.household_id);
      allow create, update: if signedIn() &&
        request.resource.data.user_id == request.auth.uid &&
        isHouseholdMember(request.resource.data.household_id);
      allow delete: if signedIn() &&
        resource.data.user_id == request.auth.uid &&
        isHouseholdMember(resource.data.household_id);
    }

    match /journalEntries/{entryId} {
      allow read, write: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
    }

    match /studyProjects/{projectId} {
      allow read, write: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
    }

    match /studyQuestions/{questionId} {
      allow read, write: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
    }

    match /highlights/{highlightId} {
      allow read: if signedIn() && (
        resource.data.user_id == request.auth.uid ||
        (resource.data.shared_to_household == true && isHouseholdMember(resource.data.household_id))
      );
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    match /linkReferences/{linkId} {
      allow read: if signedIn() && (
        resource.data.user_id == request.auth.uid ||
        (resource.data.shared_to_household == true && isHouseholdMember(resource.data.household_id))
      );
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    match /reminderSettings/{settingId} {
      allow read, write: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
    }
  }
}
